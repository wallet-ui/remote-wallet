{
  "bin": {
    "remote-wallet": "dist/cli.mjs"
  },
  "dependencies": {},
  "description": "TypeScript library and CLI for remote wallet workflows.",
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "2.30.0",
    "@intellectronica/ruler": "0.3.38",
    "@types/bun": "1.3.13",
    "lefthook": "2.1.5",
    "pkg-pr-new": "0.0.62",
    "publint": "0.3.18",
    "tsdown": "0.21.7",
    "typescript": "6.0.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "name": "remote-wallet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallet-ui/remote-wallet.git"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check-types": "tsc -b --noEmit",
    "ci": "bun run build && bun run lint && bun run check-types && bun test",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --error-on-warnings --write",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "ruler:apply": "ruler apply --local-only",
    "test": "bun test test/*.test.ts",
    "test:watch": "bun test test/*.test.ts --watch",
    "version": "changeset version && bun lint:fix"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "version": "0.0.0"
}
